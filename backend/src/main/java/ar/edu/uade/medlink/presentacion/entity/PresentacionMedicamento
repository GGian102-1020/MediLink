package ar.edu.uade.medlink.presentacion.entity;
import jakarta.persistence.*;
import lombok.AccessLevel;
import lombok.Getter;
import lombok.NoArgsConstructor;
import org.hibernate.annotations.JdbcTypeCode;
import org.hibernate.type.SqlTypes;
import jakarta.persistence.Enumerated;
import jakarta.persistence.EnumType;
import jakarta.persistence.ManyToOne;
import jakarta.persistence.JoinColumn;
import presentacion.enums.CondicionDipensa;
@Entity
@Table
public class PresentacionMedicamento{
    @Id
    @ConstructValue(strategy = GenerationType.IDENTITY)
    private Long idPresentacion;

    @ManyToOne
    @JoinColumn(name = "idMedicamento", nullable = false)
    private Medicamento medicamento;

    @Column(nullable = false)
    private String concentracion;

    @Column(nullable = false)
    private String formaFarmaceutica;

    @Column(nullable = false)
    private String cantidadEnvase;

    @Column(nullable = false)
    private String unidadExpendio;

    @Enumerated(EnumType.STRING)
    @Column(nullable = false)
    private CondicionDipensa condicionDispensa;

    @Column(nullable = false)
    private boolean activo = true;

    public PresentacionMedicamento(
        Medicamento medicamento,
        String concentracion,
        String formaFarmaceutica,
        String cantidadEnvase,
        String unidadExpendio,
        CondicionDispensa condicionDispensa) {

        this.medicamento = medicamento;
        this.concentracion = concentracion;
        this.formaFarmaceutica = formaFarmaceutica;
        this.cantidadEnvase = cantidadEnvase;
        this.unidadExpendio = unidadExpendio;
        this.condicionDispensa = condicionDispensa;
        this.activo = true;
    }


    public boolean requiereReceta(){
        return this.condicionDispensa = CondicionDipensa.Bajo_Receta;
    }
    public boolean estaActivo(){
        return activo;
    }
}
