# SOLO DEMO LOCAL. Copiar a .env; nunca publicar contraseñas de ejemplo.
POSTGRES_DB=medlink
POSTGRES_USER=medlink
POSTGRES_PASSWORD=medlink123
POSTGRES_PORT=5432
ADMINER_PORT=8080
# Para ejecutar API: generá una clave local fuerte, por ejemplo:
# python3 -c 'import secrets,base64; print(base64.b64encode(secrets.token_bytes(32)).decode())'
JWT_SECRET_BASE64=
HTTPS_PORT=8443
# La instalación nueva es gestionada por Flyway (false).
# true solo para adoptar una base antigua previamente verificada y respaldada.
DB_FLYWAY_BASELINE_ON_MIGRATE=false
# Opcional, únicamente para frontend React desde otro origen:
MEDLINK_CORS_ALLOWED_ORIGINS=
